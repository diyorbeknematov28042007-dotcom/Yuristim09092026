{
  "name": "@yuristim/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "lint": "eslint src",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@yuristim/config": "workspace:*",
    "grammy": "1.46.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "tsx": "4.23.13"
  }
}
