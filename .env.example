# Shared runtime mode
NODE_ENV=development

# API (server-only)
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
INTERNAL_BOT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=
SESSION_TTL_SECONDS=2592000
LOGIN_CHALLENGE_TTL_SECONDS=600
ADMIN_SESSION_TTL_SECONDS=28800
WEEKLY_CREDIT_JOB_INTERVAL_SECONDS=3600
# Optional one-time admin bootstrap. Configure both or leave both empty.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# AI Gateway (API service only; provider keys are secrets)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_FAST_MODEL=gemini-3.5-flash-lite
# Optional: openai or anthropic. If omitted, the first configured expert provider is selected.
AI_EXPERT_PROVIDER=
AI_EXPERT_MODEL=
AI_FAST_INPUT_COST_PER_MILLION_USD=0.3
AI_FAST_OUTPUT_COST_PER_MILLION_USD=2.5
AI_EXPERT_INPUT_COST_PER_MILLION_USD=
AI_EXPERT_OUTPUT_COST_PER_MILLION_USD=
AI_MARKUP_MULTIPLIER=1.5
AI_USD_PER_CREDIT=0.002
AI_PROVIDER_TIMEOUT_MILLISECONDS=45000
AI_PROVIDER_MAX_RETRIES=1
AI_FAST_CONTEXT_TOKENS=32768
AI_EXPERT_CONTEXT_TOKENS=65536
AI_FAST_MAX_OUTPUT_TOKENS=2048
AI_EXPERT_MAX_OUTPUT_TOKENS=4096

# Bot (server-only)
TELEGRAM_BOT_TOKEN=
MARKETPLACE_CHANNEL_ID=-1003512004134
MARKETPLACE_CHANNEL_URL=https://t.me/yuristim_marketplace
ADMIN_TELEGRAM_ID=
API_BASE_URL=http://localhost:3001
API_TIMEOUT_MILLISECONDS=5000
AI_API_TIMEOUT_MILLISECONDS=60000
TERMS_VERSION=2026-09
PUBLIC_OFFER_URL=
PRIVACY_URL=
SUPPORT_USERNAME=
MINI_APP_URL=
# Bot reuses INTERNAL_BOT_API_SECRET defined in the API section.

# Web (public; values are included in the browser bundle)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
