# Shared runtime mode
NODE_ENV=development

# API (server-only)
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret

# Bot (server-only)
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
API_BASE_URL=http://localhost:3001

# Web (public; values are included in the browser bundle)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-key
