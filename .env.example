# Shared runtime mode
NODE_ENV=development

# API (server-only)
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
INTERNAL_BOT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=
SESSION_TTL_SECONDS=2592000
LOGIN_CHALLENGE_TTL_SECONDS=600
ADMIN_SESSION_TTL_SECONDS=28800
WEEKLY_CREDIT_JOB_INTERVAL_SECONDS=3600
# Optional one-time admin bootstrap. Configure both or leave both empty.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# AI Gateway (API service only; provider keys are secrets)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
BAI_API_KEY=
BAI_BASE_URL=https://api.b.ai/v1
BAI_MODEL=deepseek-v4.1-flash
BAI_REASONING_EFFORT=high
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=high
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high
AI_EXPERT_PROVIDER_MODE=auto
AI_EXPERT_PROVIDER_ORDER=bai,openai,anthropic
# Required only when AI_EXPERT_PROVIDER_MODE=fixed.
AI_EXPERT_PROVIDER=
# Emergency provider kill switches (non-secret).
AI_PROVIDER_GEMINI_ENABLED=true
AI_PROVIDER_BAI_ENABLED=true
AI_PROVIDER_OPENAI_ENABLED=true
AI_PROVIDER_ANTHROPIC_ENABLED=true
AI_PROVIDER_FAILURE_THRESHOLD=3
AI_PROVIDER_FAILURE_WINDOW_SECONDS=120
AI_PROVIDER_COOLDOWN_SECONDS=300
AI_PROVIDER_MAX_COOLDOWN_SECONDS=1800
# Backward-compatible model aliases; prefer the provider-specific variables above.
AI_FAST_MODEL=
AI_EXPERT_MODEL=
AI_FAST_INPUT_COST_PER_MILLION_USD=0.3
AI_FAST_OUTPUT_COST_PER_MILLION_USD=2.5
AI_EXPERT_INPUT_COST_PER_MILLION_USD=
AI_EXPERT_OUTPUT_COST_PER_MILLION_USD=
AI_MARKUP_MULTIPLIER=1.5
AI_USD_PER_CREDIT=0.002
AI_PROVIDER_TIMEOUT_MILLISECONDS=45000
AI_PROVIDER_MAX_RETRIES=1
AI_FAST_CONTEXT_TOKENS=32768
AI_EXPERT_CONTEXT_TOKENS=65536
AI_FAST_MAX_OUTPUT_TOKENS=2048
AI_EXPERT_MAX_OUTPUT_TOKENS=4096

# Bot (server-only)
TELEGRAM_BOT_TOKEN=
MARKETPLACE_CHANNEL_ID=-1003512004134
MARKETPLACE_CHANNEL_URL=https://t.me/yuristim_marketplace
ADMIN_TELEGRAM_ID=
API_BASE_URL=http://localhost:3001
API_TIMEOUT_MILLISECONDS=5000
AI_API_TIMEOUT_MILLISECONDS=60000
TERMS_VERSION=2026-09
PUBLIC_OFFER_URL=
PRIVACY_URL=
SUPPORT_USERNAME=
MINI_APP_URL=
# Optional, non-secret Telegram sticker file IDs used as temporary AI status indicators.
TELEGRAM_AI_FAST_STICKER_FILE_ID=
TELEGRAM_AI_EXPERT_STICKER_FILE_ID=
TELEGRAM_AI_DOCUMENT_STICKER_FILE_ID=
# Bot reuses INTERNAL_BOT_API_SECRET defined in the API section.

# Web (public; values are included in the browser bundle)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
