# Shared runtime mode
NODE_ENV=development

# API (server-only)
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
INTERNAL_BOT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=
SESSION_TTL_SECONDS=2592000
LOGIN_CHALLENGE_TTL_SECONDS=600
ADMIN_SESSION_TTL_SECONDS=28800
WEEKLY_CREDIT_JOB_INTERVAL_SECONDS=3600
# Optional one-time admin bootstrap. Configure both or leave both empty.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Bot (server-only)
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=
API_BASE_URL=http://localhost:3001
API_TIMEOUT_MILLISECONDS=5000
TERMS_VERSION=2026-09
PUBLIC_OFFER_URL=
PRIVACY_URL=
SUPPORT_USERNAME=
# Bot reuses INTERNAL_BOT_API_SECRET defined in the API section.

# Web (public; values are included in the browser bundle)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
