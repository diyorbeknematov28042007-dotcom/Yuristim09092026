# Shared runtime mode
NODE_ENV=development

# API (server-only)
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
SESSION_SECRET=replace-with-at-least-32-random-characters
INTERNAL_BOT_API_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=2592000
LOGIN_CHALLENGE_TTL_SECONDS=600

# Bot (server-only)
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
API_BASE_URL=http://localhost:3001
API_TIMEOUT_MILLISECONDS=5000
TERMS_VERSION=2026-09
PUBLIC_OFFER_URL=
PRIVACY_URL=
SUPPORT_USERNAME=
# Bot reuses INTERNAL_BOT_API_SECRET defined in the API section.

# Web (public; values are included in the browser bundle)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-key
